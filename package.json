{
  "name": "web2-lab2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "npm run clean && tsc && npm run copy-files",
    "clean": "shx rm -rf dist",
    "copy-files": "shx cp -r src/views src/public dist",
    "start": "node --env-file-if-exists=.env dist/main.js"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "^3.54.1-build1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "pug": "^3.0.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "shx": "^0.4.0",
    "typescript": "~5.9.3"
  }
}
